# Copy to .env — never commit the real file.
# All keys are optional: with none set, Cortex runs in deterministic extractive mode.

# Generative planning + synthesis (pick one)
ANTHROPIC_API_KEY=
# CORTEX_ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CORTEX_OPENAI_MODEL=gpt-4o-mini

# Polite identification for Wikipedia / arXiv requests (put your contact here)
# CORTEX_USER_AGENT=CortexResearch/1.0 (you@example.com)

# Tuning
# CORTEX_MAX_RUNS=3
# CORTEX_HTTP_TIMEOUT=12
# CORTEX_RUNS_DIR=runs
